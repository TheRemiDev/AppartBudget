# Port d'ecoute du serveur (choisissez un port libre sur votre VPS)
PORT=4310

# Base de donnees SQLite (fichier local, cree automatiquement au demarrage).
# Note: pour Prisma, ce chemin relatif est resolu depuis le dossier prisma/,
# donc "../data/..." pointe vers server/data/appartbudget.db.
DATABASE_URL="file:../data/appartbudget.db"

# Secret utilise pour signer les tokens de session (generer une valeur aleatoire longue)
# Exemple pour en generer une: openssl rand -hex 32
JWT_SECRET="change-me-please-use-a-long-random-value"

# Duree de validite de la session (ex: 30d, 12h)
JWT_EXPIRES_IN="30d"

# Origine autorisee pour les requetes cross-site (utile seulement si le frontend
# n'est pas servi par ce meme serveur). Laisser vide en usage standard.
CORS_ORIGIN=

# Mettre a "true" derriere un reverse proxy HTTPS (nginx, caddy...) pour que le
# cookie de session soit marque "secure"
TRUST_PROXY_HTTPS=false

# Environnement
NODE_ENV=production
